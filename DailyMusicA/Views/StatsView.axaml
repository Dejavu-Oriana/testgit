<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DailyMusicA.Library.ViewModels"
             xmlns:models="clr-namespace:DailyMusicA.Library.Models;assembly=DailyMusicA.Library"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="650"
             x:Class="DailyMusicA.Views.StatsView"
             x:DataType="vm:StatsViewModel">

    <ScrollViewer Background="#F5F7FA"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16">
        <StackPanel Spacing="14" MaxWidth="1200" HorizontalAlignment="Stretch">
            <TextBlock Text="数据概览"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1F2937"
                       Margin="0,0,0,4"/>

            <Grid ColumnDefinitions="*,12,*,12,*"
                  ColumnSpacing="0">
                <Border Background="#0F172A"
                        CornerRadius="12"
                        Padding="18,16"
                        BoxShadow="0 4 12 0 #15000000">
                    <StackPanel Spacing="6">
                        <TextBlock Text="专辑总数"
                                   Foreground="#CBD5F5"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding AlbumCount}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#1D4ED8"
                        CornerRadius="12"
                        Padding="18,16"
                        BoxShadow="0 4 12 0 #15000000">
                    <StackPanel Spacing="6">
                        <TextBlock Text="歌曲总数"
                                   Foreground="#DBEAFE"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding SongCount}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="#0EA5E9"
                        CornerRadius="12"
                        Padding="18,16"
                        BoxShadow="0 4 12 0 #15000000">
                    <StackPanel Spacing="6">
                        <TextBlock Text="收藏歌曲"
                                   Foreground="#E0F2FE"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding FavoriteSongCount}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,14,*"
                  ColumnSpacing="0">
                <Border Background="#FFFFFF"
                        CornerRadius="10"
                        Padding="16"
                        BorderBrush="#E3E7EF"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Stretch">
                            <TextBlock Text="最近新增"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center"/>
                            <Button Content="刷新"
                                    Command="{Binding RefreshCommand}"
                                    Width="70"
                                    Height="30"
                                    Margin="12,0,0,0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    CornerRadius="6"
                                    FontSize="12"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding RecentAlbums}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Border Padding="10"
                                            Margin="0,0,0,6"
                                            Background="#F1F5F9"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="12"
                                                       Foreground="#475569"/>
                                            <TextBlock Text="{Binding AddedDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2"
                            Spacing="12">
                    <Border Background="#FFFFFF"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#E3E7EF"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="最活跃艺术家"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>
                            <TextBlock Text="{Binding TopArtistName}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding TopArtistSongCount, StringFormat='歌曲数量：{0}'}"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#E3E7EF"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="歌曲最多的专辑"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>
                            <TextBlock Text="{Binding MostSongsAlbum.Name, FallbackValue=暂无数据}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding MostSongsAlbum.Artist}"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock Text="{Binding MostSongsAlbum.Songs.Count, FallbackValue=0, StringFormat='歌曲：{0} 首'}"
                                       FontSize="12"
                                       Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF"
                            CornerRadius="10"
                            Padding="16"
                            BorderBrush="#E3E7EF"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="收藏歌曲预览"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>
                            <ItemsControl ItemsSource="{Binding FavoriteSongsPreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Song">
                                        <Border Padding="8"
                                                Margin="0,0,0,5"
                                                Background="#F8FAFC"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Artist}"
                                                           FontSize="11"
                                                           Foreground="#64748B"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

